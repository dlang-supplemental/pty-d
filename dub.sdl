name "pty-d"
description "Thin portable PTY bindings for D: Windows ConPTY + POSIX posix_openpt"
authors "amdphreak"
copyright "Copyright (c) 2026, dlang-supplemental contributors"
license "MIT"
version "0.1.0"
# Keep in sync with VERSION / git tag vX.Y.Z.

targetType "library"
targetName "pty_d"

importPaths "source"
sourcePaths "source"
stringImportPaths "."

configuration "library" {
	targetType "library"
}

configuration "unittest" {
	targetType "library"
}